{
  "name": "openaq-mcp-server",
  "version": "0.1.4",
  "description": "Find air-quality monitoring stations, read latest sensor values, and pull historical pollutant series via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/openaq-mcp-server",
  "repository": "https://github.com/cyanheads/openaq-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "openaq-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/openaq-mcp-server"
      ],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "OPENAQ_API_KEY": "${OPENAQ_API_KEY}"
      }
    }
  }
}
